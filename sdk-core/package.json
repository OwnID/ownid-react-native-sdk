{
  "name": "@ownid/react-native-core",
  "version": "4.0.1",
  "description": "OwnID React Native Core SDK",
  "author": "OwnID, Inc.",
  "license": "Apache-2.0",
  "homepage": "https://www.ownid.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/OwnID/ownid-react-native-sdk.git",
    "directory": "sdk-core"
  },
  "bugs": {
    "url": "https://github.com/OwnID/ownid-react-native-sdk/issues"
  },
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "!android/build"
  ],
  "keywords": [
    "react-native",
    "android",
    "ios",
    "ownid"
  ],
  "engines": {
    "node": "^20.19.4 || ^22.13.0 || >=24.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11 <12",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "bob build",
    "typecheck": "tsc --project tsconfig.test.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "tsc --project tsconfig.test.json --noEmit && tsx --test",
    "format": "prettier --write \"**/*.{js,json,md,mjs,ts,tsx}\"",
    "format:check": "prettier --check \"**/*.{js,json,md,mjs,ts,tsx}\"",
    "prepack": "bob build"
  },
  "peerDependencies": {
    "react": ">=19.2.0 <20.0.0",
    "react-native": ">=0.83.0",
    "react-native-webview": ">=16.0.0 <17.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "20.19.43",
    "@types/react": "19.2.18",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-builder-bob": "0.43.1",
    "react-native-webview": "16.0.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      "typescript"
    ]
  }
}
